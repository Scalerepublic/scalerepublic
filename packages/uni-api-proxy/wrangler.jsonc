	"main": "src/index.ts",
	"compatibility_date": "2026-06-12",
	"observability": {
		"enabled": true
	},
	"env": {
		"production": {
			"name": "scalerepublic-uni-proxy"
		},
		"staging": {
			"name": "scalerepublic-uni-proxy-staging"
		}
	}
}
