{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "6a0955753ada2dde00b92d526f9d8f30",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"env": {
		"production": {
			"name": "scalerepublic-backend",
			"observability": {
				"enabled": true
			},
			"vars": {
				"NODE_ENV": "production",
				"STOCK_DEBUG": "false",
				"STOCK_API_PROVIDER": "uni",
				"BETTER_AUTH_URL": "https://scalerepublic-frontend.tu-projects.workers.dev",
				"SYNC_INTERVAL_MS": "3600000",
				"SYNC_MAX_TICKERS": "500",
				"MIN_NET_WORTH_THRESHOLD": "1.00",
				"CATALOG_BACKFILL_NAMES_PER_TICK": "20",
				"CATALOG_BACKFILL_HISTORY_STOCKS_PER_TICK": "8",
				"CATALOG_BACKFILL_BARS_PER_STOCK": "10",
				"CATALOG_BACKFILL_MAX_API_CALLS": "55",
				"DETAIL_ON_DEMAND_PREFETCH_MAX_FETCHES": "30",
				"UNI_API_BASE_URL": "https://uni-api.internal"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "8f842c6819e2483c92cdccf52f62ab11",
					"localConnectionString": "postgres://postgres:postgres@localhost:50025/scalerepublic"
				}
			],
			"services": [
				{
					"binding": "UNI_API_PROXY",
					"service": "scalerepublic-uni-proxy"
				}
			],
			"triggers": {
				"crons": [
					"0 * * * *"
				]
			}
		},
		"staging": {
			"name": "scalerepublic-backend-staging",
			"observability": {
				"enabled": true
			},
			"vars": {
				"NODE_ENV": "staging",
				"STOCK_DEBUG": "false",
				"STOCK_API_PROVIDER": "uni",
				"BETTER_AUTH_URL": "https://scalerepublic-frontend-staging.tu-projects.workers.dev",
				"SYNC_INTERVAL_MS": "60000",
				"SYNC_MAX_TICKERS": "500",
				"MIN_NET_WORTH_THRESHOLD": "1.00",
				"CATALOG_BACKFILL_NAMES_PER_TICK": "20",
				"CATALOG_BACKFILL_HISTORY_STOCKS_PER_TICK": "8",
				"CATALOG_BACKFILL_BARS_PER_STOCK": "10",
				"CATALOG_BACKFILL_MAX_API_CALLS": "55",
				"DETAIL_ON_DEMAND_PREFETCH_MAX_FETCHES": "30",
				"UNI_API_BASE_URL": "https://uni-api.internal"
			},
			"hyperdrive": [
				{
					"binding": "HYPERDRIVE",
					"id": "6029c73c4e91463c94f87d129be4e47e",
					"localConnectionString": "postgres://postgres:postgres@localhost:50025/scalerepublic"
				}
			],
			"services": [
				{
					"binding": "UNI_API_PROXY",
					"service": "scalerepublic-uni-proxy-staging"
				}
			],
			"triggers": {
				"crons": [
					"* * * * *"
				]
			}
		}
	}
}
